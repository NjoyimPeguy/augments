{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/sh/session-start.sh\" SessionStart",
            "timeout": 15,
            "statusMessage": "Loading the SDLC skills router"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|exec",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/sh/implementation-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking implementation-entry disciplines"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|exec",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/sh/implementation-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
